@page
@model UFWebsite.Pages.Admin.LoginModel
@{ ViewData["Title"] = "Logga in"; }

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h1 class="h3 mb-3">Ticshare Admin</h1>
        @if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }
        <form method="post">
            <div class="mb-3">
                <label class="form-label">E-post</label>
                <input asp-for="Email" class="form-control" type="email" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Lösenord</label>
                <input asp-for="Password" class="form-control" type="password" required />
            </div>
            <button class="btn btn-primary w-100">Logga in</button>
        </form>
    </div>
</div>
