@page
@model UFWebsite.Pages.Admin.UsersModel
@{ ViewData["Title"] = "Användare"; }

<h1 class="h3 mb-3">Användare</h1>
<p class="text-muted">Lösenord sparas bara som hash och kan aldrig visas, inte ens här.</p>

<table class="table table-sm">
    <thead><tr><th>Namn</th><th>E-post</th><th>Swish</th><th>Registrerad (UTC)</th><th>Säsongskort</th><th>Admin</th></tr></thead>
    <tbody>
    @foreach (var u in Model.Users)
    {
        <tr>
            <td>@u.FullName</td><td>@u.Email</td><td>@u.SwishNumber</td>
            <td>@u.CreatedAt.ToString("yyyy-MM-dd")</td><td>@u.Cards</td><td>@(u.IsAdmin ? "Ja" : "")</td>
        </tr>
    }
    </tbody>
</table>
